#!/bin/sh
# Runs the repo checks before every push. Enable once: git config core.hooksPath .githooks
set -e
cd "$(git rev-parse --show-toplevel)"
python3 tests/check.py
if command -v claude >/dev/null 2>&1; then
  claude plugin validate . >/dev/null
  claude plugin validate --profile directory plugins/sdops >/dev/null
  echo "plugin validate: ok"
fi
# Client names live only on this machine, one per line, never in the repo.
names=.git/info/private-names
if [ -s "$names" ] && git grep -n -i -F -f "$names" -- . ':!.githooks'; then
  echo "pre-push: a private client name is in the repo (listed above)"; exit 1
fi
